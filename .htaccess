Options -Indexes
DirectoryIndex index.php

<FilesMatch "(^\.|\.env|\.log$|\.sql$|\.bak$|\.backup$|composer\.(json|lock)$|package(-lock)?\.json$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  <FilesMatch "\.(?:css|js|webp|png|jpg|jpeg|woff2?|webm|mp4|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, private"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType image/x-icon .ico
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Return HTTP 404 directly for missing static assets without executing PHP 404 HTML
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} \.(?:css|js|png|webp|jpe?g|gif|ico|svg|woff2?|map|ttf|eot)$ [NC]
  RewriteRule ^ - [R=404,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.php [END]
</IfModule>

ErrorDocument 500 default
