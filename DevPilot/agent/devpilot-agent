#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * DevPilot Local Agent
 * Runs on ThinkPad and polls the portfolio API for operations
 * Outbound-only connection: Agent initiates HTTPS requests to the server
 */

if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "This agent must run from the command line.\n");
    exit(1);
}

require_once dirname(__DIR__) . '/vendor/autoload.php';

use DevPilot\Config;
use DevPilot\Discovery;
use DevPilot\Logger;
use DevPilot\Project;

const VERSION = '1.0.0';
const API_BASE_URL = 'https://kennedycheroben.co.ke/admin/api/devpilot';

$options = [
    'deviceId' => null,
    'secret' => null,
    'token' => null,
    'pollInterval' => 30,
    'projectPath' => null,
    'verbose' => false,
];

function showHelp(): void
{
    echo <<<'HELP'
DevPilot Local Agent v1.0.0
Usage: devpilot-agent [options]

Options:
  --device-id <id>     Registered device ID
  --secret <secret>    Device secret (from registration)
  --token <token>      Authentication token (alternative to secret)
  --poll <seconds>     Poll interval (default: 30)
  --project <path>     Path to project for local operations
  --verbose            Enable verbose output
  --help               Show this help

Examples:
  # Register a new device (returns deviceId and secret)
  devpilot-agent --register "ThinkPad" --public-key <base64_key>

  # Run as daemon
  devpilot-agent --daemon --device-id dev_xyz --secret <secret> --project /path/to/project

  # Check status
  devpilot-agent --status --device-id dev_xyz --secret <secret>

Commands:
  --register <name>    Register this device (requires --public-key)
  --daemon             Run as daemon, polling for operations
  --status             Show current agent status
  --poll-once          Poll once and execute any pending operations

HELP;
}

function getConfigFile(): string
{
    $home = getenv('HOME') ?: sys_get_temp_dir();
    $configDir = $home . '/.devpilot';
    if (!is_dir($configDir)) {
        @mkdir($configDir, 0700, true);
    }
    return $configDir . '/agent.json';
}

function loadConfig(): ?array
{
    $configFile = getConfigFile();
    if (!is_readable($configFile)) {
        return null;
    }

    $config = json_decode(file_get_contents($configFile), true);
    return is_array($config) ? $config : null;
}

function saveConfig(array $config): void
{
    $configFile = getConfigFile();
    file_put_contents($configFile, json_encode($config, JSON_PRETTY_PRINT));
    chmod($configFile, 0600);
}

function generateDeviceId(string $name): string
{
    return 'dev_' . substr(hash('sha256', $name . ':' . bin2hex(random_bytes(16)) . ':' . microtime(true)), 0, 32);
}

function generateToken(string $deviceId, string $secret): string
{
    $nonce = bin2hex(random_bytes(16));

    $header = base64_encode(json_encode(['alg' => 'HS256', 'typ' => 'JWT']));
    $payload = base64_encode(json_encode([
        'deviceId' => $deviceId,
        'iat' => time(),
        'exp' => time() + 300,
        'tokenNonce' => $nonce,
    ]));

    $signature = hash_hmac('sha256', $header . '.' . $payload, $secret, true);
    $sigBase64 = rtrim(strtr(base64_encode($signature), '+/', '-_'), '=');

    return $header . '.' . $payload . '.' . $sigBase64;
}

function pollApi(string $method, string $endpoint, string $body = '', string $token = '', int $timeout = 30): array
{
    $url = API_BASE_URL . '/' . $endpoint;
    $ch = curl_init($url);

    $headers = ['Content-Type: application/json; charset=utf-8'];
    if ($token !== '') {
        $headers[] = 'Authorization: Bearer ' . $token;
    }

    curl_setopt_array($ch, [
        CURLOPT_HTTPHEADER => $headers,
        CURLOPT_CUSTOMREQUEST => $method,
        CURLOPT_POSTFIELDS => $body,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT => $timeout,
        CURLOPT_SSL_VERIFYPEER => true,
        CURLOPT_USERAGENT => 'DevPilot-Agent/' . VERSION,
    ]);

    $response = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $error = curl_error($ch);
    curl_close($ch);

    if ($error) {
        return ['error' => $error, 'status' => 0];
    }

    $data = json_decode($response, true);
    if (is_array($data)) {
        $data['status'] = $httpCode;
        return $data;
    }

    return ['raw' => $response, 'status' => $httpCode];
}

function executeOperation(array $project, string $operation): array
{
    try {
        switch ($operation) {
            case 'check_health':
                return [
                    'healthy' => true,
                    'issues' => [],
                    'warnings' => [],
                    'language' => $project->language,
                    'framework' => $project->framework,
                    'pathExists' => is_dir($project->path),
                    'executedAt' => date('c'),
                ];

            case 'run_discovery':
                $discovery = Discovery::detect($project->path);
                return [
                    'projectId' => $project->id,
                    'discovery' => $discovery,
                    'executedAt' => date('c'),
                ];

            case 'get_status':
                return [
                    'projectId' => $project->id,
                    'name' => $project->name,
                    'status' => $project->status,
                    'language' => $project->language,
                    'framework' => $project->framework,
                    'executedAt' => date('c'),
                ];

            default:
                return ['error' => "Unknown operation: {$operation}", 'success' => false];
        }
    } catch (\Throwable $e) {
        return ['error' => $e->getMessage(), 'success' => false];
    }
}

function runDaemon(int $pollInterval, string $deviceId, string $secret, ?string $projectPath): void
{
    $token = generateToken($deviceId, $secret);

    echo "Starting DevPilot Agent...\n";
    echo "Device: {$deviceId}\n";
    echo "Poll interval: {$pollInterval}s\n";
    if ($projectPath !== null) {
        echo "Project path: {$projectPath}\n";
    }
    echo "\n";

    while (true) {
        $response = pollApi('GET', 'operations?status=pending&deviceId=' . $deviceId, '', $token, 30);

        if (isset($response['success']) && $response['success'] && isset($response['operations'])) {
            foreach ($response['operations'] as $op) {
                echo "Operation #{$op['id']}: {$op['operation']}\n";
                runOperation($deviceId, $secret, $op, $projectPath);
            }
        }

        sleep($pollInterval);
    }
}

function runOperation(string $deviceId, string $secret, array $op, ?string $projectPath): void
{
    $projectId = $op['projectId'] ?? 0;
    $operation = $op['operation'] ?? '';

    if ($projectId <= 0) {
        echo "  Error: Invalid project ID\n";
        return;
    }

    if ($projectPath === null || !is_dir($projectPath)) {
        echo "  Error: No project path configured\n";
        return;
    }

    $project = new Project(
        id: $projectId,
        name: basename($projectPath),
        path: $projectPath,
        language: Discovery::detect($projectPath)['primaryLanguage'] ?? 'unknown'
    );

    $result = executeOperation($project, $operation);

    $response = pollApi('POST', 'operations/' . $op['id'] . '/execute', json_encode([
        'deviceId' => $deviceId,
        'result' => $result,
    ]), $secret !== '' ? generateToken($deviceId, $secret) : '', 30);

    echo "  Result: " . (isset($response['success']) && $response['success'] ? 'Success' : 'Failed') . "\n";
}

function checkStatus(string $deviceId, string $secret): void
{
    $config = loadConfig();
    if ($config !== null) {
        echo "Stored configuration found\n";
        echo "Device ID: {$config['deviceId']}\n";
    }

    if ($deviceId === '' && $config !== null) {
        $deviceId = $config['deviceId'] ?? '';
        $secret = $config['secret'] ?? '';
    }

    if ($deviceId === '' || $secret === '') {
        echo "No device credentials found. Use --device-id and --secret or run --register first.\n";
        return;
    }

    $token = generateToken($deviceId, $secret);
    $response = pollApi('GET', 'devices', '', $token, 30);

    if (isset($response['success']) && $response['success']) {
        $devices = $response['devices'] ?? [];
        foreach ($devices as $id => $device) {
            $status = ($device['revoked'] ?? false) ? 'REVOKED' : (($device['online'] ?? false) ? 'ONLINE' : 'OFFLINE');
            echo "Device: {$id}\n";
            echo "  Name: {$device['name']}\n";
            echo "  Status: {$status}\n";
            echo "  Last seen: {$device['lastSeen']}\n";
        }
    } else {
        echo "Failed to get status: " . ($response['error'] ?? 'Unknown error') . "\n";
    }
}

function registerDevice(string $name, string $publicKey = ''): void
{
    $deviceId = generateDeviceId($name);
    $secret = bin2hex(random_bytes(32));

    if ($publicKey === '') {
        $publicKey = base64_encode(random_bytes(32));
    }

    $response = pollApi('POST', 'devices', json_encode([
        'name' => $name,
        'publicKey' => $publicKey,
    ]), '', 30);

    if (isset($response['success']) && $response['success']) {
        echo "Device registered successfully\n";
        echo "Device ID: {$deviceId}\n";
        echo "Secret: {$secret}\n";
        echo "Token: " . generateToken($deviceId, $secret) . "\n";

        saveConfig([
            'deviceId' => $deviceId,
            'secret' => $secret,
            'name' => $name,
            'registeredAt' => date('c'),
        ]);

        echo "\nConfiguration saved to " . getConfigFile() . "\n";
        echo "Use --daemon --device-id {$deviceId} --secret <secret> to start polling.\n";
    } else {
        echo "Registration failed: " . ($response['error'] ?? 'Unknown error') . "\n";
        exit(1);
    }
}

foreach ($argv as $i => $arg) {
    if (strpos($arg, '--') === 0) {
        $key = ltrim($arg, '--');

        switch ($key) {
            case 'help':
            case 'h':
                showHelp();
                exit(0);

            case 'daemon':
                $deviceId = $options['deviceId'] ?? $argv[$i + 1] ?? '';
                $secret = $options['secret'] ?? $argv[$i + 2] ?? '';
                $projectPath = $options['project'] ?? $argv[$i + 3] ?? null;

                if ($deviceId === '' || $secret === '') {
                    // Load from config
                    $config = loadConfig();
                    if ($config === null) {
                        fwrite(STDERR, "No device registered. Use --register first.\n");
                        exit(1);
                    }
                    $deviceId = $config['deviceId'];
                    $secret = $config['secret'];
                }

                $pollInterval = (int)($options['poll'] ?? $argv[$i + 1] ?? 30);
                runDaemon($pollInterval, $deviceId, $secret, $projectPath);
                exit(0);

            case 'poll-once':
                $deviceId = $options['deviceId'] ?? $argv[$i + 1] ?? '';
                $secret = $options['secret'] ?? $argv[$i + 2] ?? '';

                if ($deviceId !== '' && $secret !== '') {
                    $token = generateToken($deviceId, $secret);
                    $response = pollApi('GET', 'health', '', $token);
                    echo json_encode($response, JSON_PRETTY_PRINT) . "\n";
                }
                exit(0);

            case 'status':
                $checkStatus($options['deviceId'] ?? '', $options['secret'] ?? '');
                exit(0);

            case 'register':
                $name = $argv[$i + 1] ?? '';
                $publicKey = $argv[$i + 2] ?? '';
                registerDevice($name, $publicKey);
                exit(0);

            case 'device-id':
                $options['deviceId'] = $argv[$i + 1];
                break;
            case 'secret':
                $options['secret'] = $argv[$i + 1];
                break;
            case 'poll':
                $options['pollInterval'] = (int)$argv[$i + 1];
                break;
            case 'project':
                $options['projectPath'] = $argv[$i + 1];
                break;
            case 'verbose':
                $options['verbose'] = true;
                break;
        }
    }
}

$config = loadConfig();
if ($config !== null) {
    echo json_encode([
        'config' => [
            'deviceId' => $config['deviceId'],
            'name' => $config['name'],
            'registeredAt' => $config['registeredAt'],
        ],
        'version' => VERSION,
    ], JSON_PRETTY_PRINT) . "\n";
} else {
    echo "DevPilot Agent v" . VERSION . "\n\n";
    showHelp();
}