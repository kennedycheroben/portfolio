{
    "name": "devpilot/core",
    "description": "Private AI Development Operations Assistant - Local Core",
    "type": "library",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "DevPilot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DevPilot\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "license": "MIT"
}