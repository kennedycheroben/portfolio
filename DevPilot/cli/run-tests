$results = test('logger redacts sensitive keys in message strings', function() use (&$results) {
    $testDir = sys_get_temp_dir() . '/devpilot-test-' . uniqid();
    @mkdir($testDir, 0755, true);
    \DevPilot\Logger::init($testDir);

    \DevPilot\Logger::info('User login with apiKey="sk-secret123" and password="mypassword"', []);
    \DevPilot\Logger::info('Auth with accessToken="at-secret" refresh_token="rt-secret" client_secret="cs-secret"', []);
    \DevPilot\Logger::info('DB config DB_PASSWORD="dbsecret" authorization="Bearer token"', []);

    $logs = \DevPilot\Logger::readLogs(10);
    $foundSecret = false;
    foreach ($logs as $log) {
        if (str_contains($log['message'], 'secret123') ||
            str_contains($log['message'], 'mypassword') ||
            str_contains($log['message'], 'at-secret') ||
            str_contains($log['message'], 'rt-secret') ||
            str_contains($log['message'], 'cs-secret') ||
            str_contains($log['message'], 'dbsecret')) {
            $foundSecret = true;
        }
    }
    assert(!$foundSecret, 'No secrets exposed in log messages');
    assert(file_exists($testDir . '/logs/operations.log'), 'Log file created');

    // Cleanup
    @unlink($testDir . '/logs/operations.log');
    @rmdir($testDir . '/logs');
    @rmdir($testDir);
}, $results);

$results = test('logger redacts sensitive context keys with naming variants', function() use (&$results) {
    $testDir = sys_get_temp_dir() . '/devpilot-test-' . uniqid();
    @mkdir($testDir, 0755, true);
    \DevPilot\Logger::init($testDir);

    \DevPilot\Logger::info('Database operation', [
        'apiKey' => 'sk-live-secret',
        'api_key' => 'sk-test-secret',
        'API-KEY' => 'sk-api-secret',
        'accessToken' => 'at-secret',
        'refresh_token' => 'rt-secret',
        'client_secret' => 'cs-secret',
        'databasePassword' => 'dbsecret',
        'DB_PASS' => 'dbpass-secret',
        'authorization' => 'Bearer token-secret',
        'normal_key' => 'normal_value',
        'nested' => [
            'secret' => 'nested_secret',
            'public' => 'public_data',
        ],
    ]);

    $logs = \DevPilot\Logger::readLogs(10);
    $foundSecret = false;
    foreach ($logs as $log) {
        $context = $log['context'] ?? [];
        $check = function($val) use (&$foundSecret) {
            if (is_string($val) && (
                str_contains($val, 'secret') ||
                str_contains($val, 'token')
            )) {
                $foundSecret = true;
            }
        };
        array_walk_recursive($context, $check);
    }
    assert(!$foundSecret, 'No secrets exposed in log context');
    assert(file_exists($testDir . '/logs/operations.log'), 'Log file created');

    // Cleanup
    @unlink($testDir . '/logs/operations.log');
    @rmdir($testDir . '/logs');
    @rmdir($testDir);
}, $results);

$results = test('logger never logs original secret when redaction fails', function() use (&$results) {
