/**
 * Explicit assertion helpers - throw on failure
 */
function assertTrue(string $name, bool $condition, string $message = ''): void
{
    if (!$condition) {
        throw new \AssertionError("Assertion failed: {$name}" . ($message ? " - {$message}" : ''));
    }
}

function assertFalse(string $name, bool $condition, string $message = ''): void
{
    if ($condition) {
        throw new \AssertionError("Assertion failed: {$name} - expected false" . ($message ? " - {$message}" : ''));
    }
}

function assertEquals(string $name, mixed $expected, mixed $actual, string $message = ''): void
{
    if ($expected !== $actual) {
        throw new \AssertionError("Assertion failed: {$name} - expected '" . var_export($expected, true) . "', got '" . var_export($actual, true) . "'" . ($message ? " - {$message}" : ''));
    }
}

function assertNotEmpty(string $name, mixed $value, string $message = ''): void
{
    if (empty($value)) {
        throw new \AssertionError("Assertion failed: {$name} - expected non-empty value" . ($message ? " - {$message}" : ''));
    }
}

function assertArrayHasKey(string $name, array $array, string|int $key, string $message = ''): void
{
    if (!array_key_exists($key, $array)) {
        throw new \AssertionError("Assertion failed: {$name} - key '{$key}' not found in array" . ($message ? " - {$message}" : ''));
    }
}

function assertNotContains(string $name, string $haystack, string $needle, string $message = ''): void
{
    if (str_contains($haystack, $needle)) {
        throw new \AssertionError("Assertion failed: {$name} - found unexpected '{$needle}' in '{$haystack}'" . ($message ? " - {$message}" : ''));
    }
}

function assertContains(string $name, string $haystack, string $needle, string $message = ''): void
{
    if (!str_contains($haystack, $needle)) {
        throw new \AssertionError("Assertion failed: {$name} - expected to find '{$needle}' in '{$haystack}'" . ($message ? " - {$message}" : ''));
    }
}

function assertInstanceOf(string $name, string $class, object $object, string $message = ''): void
{
    if (!$object instanceof $class) {
        throw new \AssertionError("Assertion failed: {$name} - expected instance of {$class}, got " . get_class($object) . ($message ? " - {$message}" : ''));
    }
}

function assertFileExists(string $name, string $path, string $message = ''): void
{
    if (!file_exists($path)) {
        throw new \AssertionError("Assertion failed: {$name} - file not found at '{$path}'" . ($message ? " - {$message}" : ''));
    }
}

function assertGreaterThan(string $name, int|float $expected, int|float $actual, string $message = ''): void
{
    if ($actual <= $expected) {
        throw new \AssertionError("Assertion failed: {$name} - expected > {$expected}, got {$actual}" . ($message ? " - {$message}" : ''));
    }
}

function assertGreaterThanOrEqual(string $name, int|float $expected, int|float $actual, string $message = ''): void
{
    if ($actual < $expected) {
        throw new \AssertionError("Assertion failed: {$name} - expected >= {$expected}, got {$actual}" . ($message ? " - {$message}" : ''));
    }
}

function assertCount(string $name, int $expected, \Countable|array $value, string $message = ''): void
{
    $count = is_countable($value) ? count($value) : 0;
    if ($count !== $expected) {
        throw new \AssertionError("Assertion failed: {$name} - expected count {$expected}, got {$count}" . ($message ? " - {$message}" : ''));
    }
}

function test(string $name, callable $fn, array &$results): void
{
    $results['executed']++;
    try {
        $fn();
        $results['passed']++;
        echo "  ✓ {$name}\n";
    } catch (Throwable $e) {
        $results['failed']++;
        $results['errors'][] = "{$name}: " . $e->getMessage();
        echo "  ✗ {$name}\n";
        echo "      " . $e->getMessage() . "\n";
    }
}

function runTestClass(string $className, array &$results): void
{
    if (!class_exists($className)) {
        $results['executed']++;
        $results['failed']++;
        $results['errors'][] = "Test class {$className} not found";
        echo "  ✗ {$className}: class not found\n";
        return;
    }

    $reflection = new ReflectionClass($className);
    $methods = $reflection->getMethods(ReflectionMethod::IS_PUBLIC);

    foreach ($methods as $method) {
        if (str_starts_with($method->getName(), 'test')) {
            $testName = "{$className}::{$method->getName()}";
            $results['executed']++;
            try {
                $instance = new $className();
                // Call setUp if exists
                if (method_exists($instance, 'setUp')) {
                    $instance->setUp();
                }
                try {
                    $method->invoke($instance);
                    $results['passed']++;
                    echo "  ✓ {$testName}\n";
                } finally {
                    // Call tearDown if exists
                    if (method_exists($instance, 'tearDown')) {
                        $instance->tearDown();
                    }
                }
            } catch (Throwable $e) {
                $results['failed']++;
                $results['errors'][] = "{$testName}: " . $e->getMessage();
                echo "  ✗ {$testName}\n";
                echo "      " . $e->getMessage() . "\n";
                // Still try to call tearDown
                if (method_exists($instance, 'tearDown')) {
                    try { $instance->tearDown(); } catch (Throwable) {}
                }
            }
        }
    }
}

