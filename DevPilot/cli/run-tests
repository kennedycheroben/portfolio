function test(string $name, callable $fn, array $results): array
{
    try {
        $fn();
        $results['passed']++;
        echo "  ✓ {$name}\n";
        return $results;
    } catch (Throwable $e) {
        $results['failed']++;
        $results['errors'][] = "{$name}: " . $e->getMessage();
        echo "  ✗ {$name}\n";
        echo "      " . $e->getMessage() . "\n";
        return $results;
    }
}

