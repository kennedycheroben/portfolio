echo "\n11. Registry Concurrency Test\n";
$results = test('concurrent registry access does not lose updates', function() use (&$results) {
    $testDir = sys_get_temp_dir() . '/devpilot-test-' . uniqid();
    @mkdir($testDir, 0755, true);
    $registryPath = $testDir . '/registry.json';

    // Initialize registry first
    $initRegistry = new \DevPilot\Registry($registryPath);
    $initRegistry->add(new \DevPilot\Project(id: 0, name: 'Init', path: '/tmp/init'));

    // We'll run multiple PHP processes that each add a project
    $script = '
        require "' . __DIR__ . '/../vendor/autoload.php";
        $registry = new DevPilot\Registry("' . $registryPath . '");
        $project = new DevPilot\Project(
            id: 0,
            name: "Concurrent Test " . getmypid(),
            path: "/tmp/concurrent-" . getmypid()
        );
        $id = $registry->add($project);
        echo "PID: " . getmypid() . " ID: " . $id . "\n";
    ';

    $processes = 5;
    $pids = [];
    for ($i = 0; $i < $processes; $i++) {
        $descriptors = [
            1 => ['pipe', 'w'],  // stdout
            2 => ['pipe', 'w'],  // stderr
        ];
        $proc = proc_open("php -r " . escapeshellarg($script), $descriptors, $pipes);
        if (is_resource($proc)) {
            $pids[] = $proc;
            fclose($pipes[1]);
        }
    }

    foreach ($pids as $proc) {
        proc_close($proc);
    }

    // Verify all projects persisted
    $registry = new \DevPilot\Registry($registryPath);
    $count = $registry->count();
    assert($count >= 5, "Expected at least 5 projects, got $count"); // 1 init + 5 concurrent

    // Verify JSON is valid
    $json = file_get_contents($registryPath);
    assert($json !== false, 'Registry file exists and readable');
    $data = json_decode($json, true);
    assert(is_array($data), 'Registry JSON is valid');
    assert(isset($data['projects']), 'Registry has projects key');
    assert(count($data['projects']) >= 5, 'All projects persisted');
    assert(count(array_unique(array_column($data['projects'], 'id'))) === count($data['projects']), 'All IDs unique');

    @unlink($registryPath);
    @rmdir($testDir);
}, $results);

// Cleanup
function removeDir(string $dir): void
{
    if (!is_dir($dir)) return;
    $items = scandir($dir);
    foreach ($items as $item) {
        if ($item === '.' || $item === '..') continue;
        $path = $dir . '/' . $item;
        is_dir($path) ? removeDir($path) : unlink($path);
    }
    rmdir($dir);
}
