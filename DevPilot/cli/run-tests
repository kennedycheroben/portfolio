$results = test('operation queue assigns unique ids under concurrent workers', function() use (&$tempDir) {
    $queueDir = $tempDir . '/operation-queue-concurrent';
    $logsDir = $tempDir . '/operation-queue-worker-logs';
    mkdir($queueDir, 0700, true);
    mkdir($logsDir, 0700, true);
    $queuePath = $queueDir . '/operations.json';
    $autoloadPath = realpath(__DIR__ . '/../autoload.php');
    $workerCount = 5;
    $operationsPerWorker = 12;
    $workers = [];

    for ($workerIndex = 0; $workerIndex < $workerCount; $workerIndex++) {
        $script = 'require ' . var_export($autoloadPath, true) . ';'
            . '\\DevPilot\\Logger::init(' . var_export($logsDir, true) . ');'
            . '$queue = new \\DevPilot\\Api\\OperationQueue(' . var_export($queuePath, true) . ');'
            . 'for ($i = 0; $i < ' . $operationsPerWorker . '; $i++) {'
            . '$queue->queue(' . $workerIndex . ', "concurrent_operation", ["worker" => ' . $workerIndex . ']);'
            . '}';
        $stdoutPath = $queueDir . '/worker-' . $workerIndex . '.out';
        $stderrPath = $queueDir . '/worker-' . $workerIndex . '.err';
        $process = proc_open(
            escapeshellarg(PHP_BINARY) . ' -r ' . escapeshellarg($script),
            [0 => ['file', '/dev/null', 'r'], 1 => ['file', $stdoutPath, 'a'], 2 => ['file', $stderrPath, 'a']],
            $pipes
        );
        assertTrue('worker process started', is_resource($process));
        $workers[] = ['process' => $process, 'exitCode' => null, 'stderr' => $stderrPath];
    }

    $deadline = microtime(true) + 20;
    do {
        $running = 0;
        foreach ($workers as &$worker) {
            if (!is_resource($worker['process'])) {
                continue;
            }
            $status = proc_get_status($worker['process']);
            if ($status['running']) {
                $running++;
                continue;
            }
            $worker['exitCode'] = $status['exitcode'];
            proc_close($worker['process']);
            $worker['process'] = null;
        }
        unset($worker);
        if ($running > 0 && microtime(true) >= $deadline) {
            foreach ($workers as &$worker) {
                if (is_resource($worker['process'])) {
                    proc_terminate($worker['process'], 9);
                    proc_close($worker['process']);
                    $worker['process'] = null;
                    $worker['exitCode'] = 124;
                }
            }
            unset($worker);
            throw new RuntimeException('Concurrent queue workers timed out, possible lock deadlock');
        }
        if ($running > 0) {
            usleep(10000);
        }
    } while ($running > 0);

    foreach ($workers as $worker) {
        assertEquals('concurrent worker exit status: ' . basename($worker['stderr']), 0, $worker['exitCode']);
        assertEquals('worker stderr is empty', '', trim((string) file_get_contents($worker['stderr'])));
    }

    $allOperations = (new \DevPilot\Api\OperationQueue($queuePath))->list();
    $expectedCount = $workerCount * $operationsPerWorker;
    $ids = array_column($allOperations, 'id');
    assertEquals('all concurrent queue writes preserved', $expectedCount, count($allOperations));
    assertEquals('all concurrent ids are unique', $expectedCount, count(array_unique($ids)));
    assertEquals('next id advances beyond all concurrent writes', $expectedCount + 1, json_decode((string) file_get_contents($queuePath), true)['next_id']);
}, $testResults);

