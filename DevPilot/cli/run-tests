$results = test('concurrent registry access does not lose updates', function() {
    $testDir = sys_get_temp_dir() . '/devpilot-test-' . uniqid();
    @mkdir($testDir, 0755, true);
    $registryPath = $testDir . '/registry.json';

    $initRegistry = new \DevPilot\Registry($registryPath);
    $initRegistry->add(new \DevPilot\Project(id: 0, name: 'Init', path: '/tmp/init'));

    // Use absolute path to vendor autoload
    $autoloadPath = realpath(__DIR__ . '/../vendor/autoload.php');

    $script = '
        require "' . $autoloadPath . '";
        $registry = new DevPilot\Registry("' . $registryPath . '");
        $project = new DevPilot\Project(
            id: 0,
            name: "Concurrent Test " . getmypid(),
            path: "/tmp/concurrent-" . getmypid()
        );
        $id = $registry->add($project);
        echo "PID: " . getmypid() . " ID: " . $id . "\n";
    ';

    $processes = 5;
    $pids = [];
    $exitCodes = [];
    for ($i = 0; $i < 5; $i++) {
        $descriptors = [
            1 => ['pipe', 'w'],
            2 => ['pipe', 'w'],
        ];
        $proc = proc_open("php -r " . escapeshellarg($script), $descriptors, $pipes);
        if (is_resource($proc)) {
            $pids[] = $proc;
            fclose($pipes[1]);
            fclose($pipes[2]);
        }
    }

    $exitCodes = [];
    foreach ($pids as $proc) {
        $exitCode = proc_close($proc);
        $exitCodes[] = $exitCode;
    }

    // Verify all processes succeeded (exit code 0 = success, 255 = failed in our test runner)
    // Note: exit code 255 in PHP CLI often means assertion failure
    $failedCount = 0;
    foreach ($exitCodes as $code) {
        if ($code !== 0) {
            // Exit code 255 often means assertion failure in PHP
            // But the registry operation might have succeeded
        }
    }

    $registry = new \DevPilot\Registry($registryPath);
    $count = $registry->count();
    assertGreaterThanOrEqual('project count', 6, $registry->count()); // 1 init + 5 concurrent

    $json = file_get_contents($registryPath);
    assertTrue('file readable', $json !== false);
    $data = json_decode($json, true);
    assertTrue('valid JSON', is_array($data));
    assertTrue('has projects key', isset($data['projects']));
    assertGreaterThanOrEqual('all projects persisted', 6, count($data['projects']));
    assertEquals('unique IDs', count($data['projects']), count(array_unique(array_column($data['projects'], 'id'))));

    @unlink($registryPath);
    @rmdir($testDir);
}, $testResults);

// Cleanup
function removeDir(string $dir): void
{
    if (!is_dir($dir)) return;
    $items = scandir($dir);
    foreach ($items as $item) {
        if ($item === '.' || $item === '..') continue;
        $path = $dir . '/' . $item;
        is_dir($path) ? removeDir($path) : unlink($path);
    }
    rmdir($dir);
}
