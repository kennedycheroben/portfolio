$results = test('operation queue serializes sequential mutations, preserves records, and releases failed writes', function() use (&$tempDir) {
    $queueDir = $tempDir . '/operation-queue-sequential';
    $logsDir = $tempDir . '/operation-queue-logs';
    mkdir($queueDir, 0700, true);
    \DevPilot\Logger::init($logsDir);
    $queuePath = $queueDir . '/operations.json';
    file_put_contents($queuePath, json_encode(['operations' => [[
        'id' => 7,
        'projectId' => 7,
        'operation' => 'legacy_queued_operation',
        'parameters' => [],
        'status' => 'pending',
        'deviceId' => null,
        'adminId' => 1,
        'approvedAt' => date('c'),
        'claimAt' => null,
        'startedAt' => null,
        'completedAt' => null,
        'result' => null,
        'error' => null,
    ]]]));
    $queue = new \DevPilot\Api\OperationQueue($queuePath);

    $firstId = $queue->queue(1, 'get_status', ['safe' => 'value']);
    $secondId = $queue->queue(2, 'run_discovery', ['api_token' => 'should-redact']);
    assertEquals('first queue id follows existing operation', 8, $firstId);
    assertEquals('second queue id follows first addition', 9, $secondId);
    assertEquals('existing and sequential operations preserved', 3, count($queue->list()));
    assertEquals('existing queued operation retained', 'legacy_queued_operation', $queue->get(7)['operation']);
    assertEquals('sensitive parameters remain redacted', '***REDACTED***', $queue->get($secondId)['parameters']['api_token']);

    $invalidResource = fopen('php://memory', 'r');
    try {
        $queue->queue(3, 'invalid_json_fixture', ['resource' => $invalidResource]);
        throw new RuntimeException('Expected queue write to reject unencodable parameters');
    } catch (RuntimeException $error) {
        assertTrue('failed write was rejected', str_contains($error->getMessage(), 'encode operations'));
    } finally {
        fclose($invalidResource);
    }

    $thirdId = $queue->queue(3, 'check_health');
    assertEquals('lock released after failed write', 10, $thirdId);
    $data = json_decode((string) file_get_contents($queuePath), true);
    assertTrue('queue file remains valid JSON', is_array($data));
    assertEquals('next id persisted', 11, $data['next_id']);
    assertEquals('atomic write kept all successful records', 4, count($data['operations']));
    assertEquals('no temporary queue files remain', [], glob($queueDir . '/.operations-*') ?: []);

    foreach ([7, $firstId, $secondId, $thirdId] as $id) {
        $queue->complete($id, ['ok' => true]);
    }
    $data = json_decode((string) file_get_contents($queuePath), true);
    foreach ($data['operations'] as &$operation) {
        $operation['approvedAt'] = '2000-01-01T00:00:00+00:00';
        $operation['completedAt'] = '2000-01-01T00:00:00+00:00';
    }
    unset($operation);
    file_put_contents($queuePath, json_encode($data, JSON_PRETTY_PRINT));
    assertEquals('expired records removed', 4, $queue->cleanExpired());
    $afterCleanupId = (new \DevPilot\Api\OperationQueue($queuePath))->queue(4, 'get_status');
    assertEquals('ids are not reused after cleanup and restart', 11, $afterCleanupId);
}, $testResults);

