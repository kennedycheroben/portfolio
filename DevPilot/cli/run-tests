    \DevPilot\Logger::info('Edge case', ['api_key' => null]);

    $logs = \DevPilot\Logger::readLogs(10);
    $foundSecret = false;
    foreach ($logs as $log) {
        if (str_contains($log['message'], 'secret') || str_contains($log['message'], 'token')) {
            $foundSecret = true;
        }
        if (isset($log['context']['password']) && $log['context']['password'] !== '***REDACTED***') {
            $foundSecret = true;
        }
        if (isset($log['context']['api_key']) && $log['context']['api_key'] !== '***REDACTED***') {
            $foundSecret = true;
        }
    }
    assert(!$foundSecret, 'No secrets leaked on edge cases');

    // Cleanup
    @unlink($testDir . '/logs/operations.log');
    @rmdir($testDir . '/logs');
    @rmdir($testDir);
}, $results);

