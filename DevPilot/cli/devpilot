#!/usr/bin/env php
<?php
declare(strict_types=1);

require_once dirname(__DIR__) . '/vendor/autoload.php';

use DevPilot\Config;
use DevPilot\Discovery;
use DevPilot\Logger;
use DevPilot\Project;
use DevPilot\Registry;

const VERSION = '1.0.0';
const ROOT = '/opt/lampp/htdocs/portfolio/DevPilot';

Config::ensureDirectories();
Logger::init(ROOT);

function showHelp(): void
{
    echo <<<'HELP'
DevPilot CLI v1.0.0
Usage: devpilot <command> [options]

Commands:
  register <path> <name>    Register a new project
  list                      List all registered projects
  discover <id|path>        Discover project metadata
  check <id|path>           Run health check on project
  show <id>                 Show project details
  unregister <id>           Remove project from registry
  find <name>               Find projects by name pattern
  health                    Show DevPilot environment health
  version                   Show DevPilot version
  help                      Show this help message

Examples:
  devpilot register /opt/lampp/htdocs/portfolio "Portfolio"
  devpilot list
  devpilot discover /opt/lampp/htdocs/portfolio

HELP;
}

function cmdRegister(array $args): void
{
    if (count($args) < 2) {
        fwrite(STDERR, "Error: register requires <path> and <name>\n");
        exit(1);
    }

    $path = realpath($args[0]) ?: $args[0];
    $name = $args[1];

    $registry = Registry::getInstance();

    $existing = $registry->findByPath($path);
    if ($existing !== null) {
        echo "Project already registered with ID {$existing->id}\n";
        return;
    }

    $detection = Discovery::detect($path);

    $project = new Project(
        id: 0,
        name: $name,
        path: $path,
        language: $detection['primaryLanguage'] ?? 'unknown',
        framework: $detection['frameworks'][0] ?? '',
        database: $detection['databases'][0] ?? null,
        environment: 'development',
        status: 'active',
        adapterStatus: 'pending',
        hosting: null
    );

    $id = $registry->add($project);
    Logger::info('Project registered', ['id' => $id, 'path' => $path]);

    echo "Registered project #{$id}: {$name}\n";
    echo "  Path: {$path}\n";
    echo "  Language: {$project->language}\n";
    echo "  Frameworks: " . implode(', ', $detection['frameworks']) . "\n";
    echo "  Databases: " . implode(', ', $detection['databases']) . "\n";
    echo "  Has Git: " . ($detection['hasGit'] ? 'yes' : 'no') . "\n";
    echo "  Has Docker: " . ($detection['hasDocker'] ? 'yes' : 'no') . "\n";
}

function cmdList(array $args): void
{
    $registry = Registry::getInstance();
    $projects = $registry->list();

    if (empty($projects)) {
        echo "No projects registered.\n";
        return;
    }

    echo sprintf("%-4s %-30s %-15s %-10s %-10s\n", "ID", "NAME", "LANGUAGE", "STATUS", "ENV");
    echo str_repeat("-", 85) . "\n";

    foreach ($projects as $project) {
        echo sprintf("%-4d %-30s %-15s %-10s %-10s\n",
            $project->id,
            substr($project->name, 0, 30),
            substr($project->language, 0, 15),
            $project->status,
            $project->environment
        );
    }
}

function cmdDiscover(array $args): void
{
    if (count($args) < 1) {
        fwrite(STDERR, "Error: discover requires <id|path>\n");
        exit(1);
    }

    $query = $args[0];
    $registry = Registry::getInstance();

    $project = null;
    if (ctype_digit($query)) {
        $project = $registry->get((int) $query);
    } else {
        $project = $registry->findByPath($query);
    }

    if ($project === null) {
        fwrite(STDERR, "Error: Project not found\n");
        exit(1);
    }

    $detection = Discovery::detect($project->path);

    echo "Discovery Results for: {$project->name}\n";
    echo "ID: {$project->id}\n\n";

    echo "Primary Language: {$detection['primaryLanguage']}\n";
    echo "Frameworks: " . implode(', ', $detection['frameworks']) . "\n";
    echo "Databases: " . implode(', ', $detection['databases']) . "\n";
    echo "Technologies: " . implode(', ', $detection['technologies']) . "\n";
    echo "Has Git: " . ($detection['hasGit'] ? 'yes' : 'no') . "\n";
    echo "Has Docker: " . ($detection['hasDocker'] ? 'yes' : 'no') . "\n";
}

function cmdShow(array $args): void
{
    if (count($args) < 1) {
        fwrite(STDERR, "Error: show requires <id>\n");
        exit(1);
    }

    $registry = Registry::getInstance();
    $project = $registry->get((int) $args[0]);

    if ($project === null) {
        fwrite(STDERR, "Error: Project not found\n");
        exit(1);
    }

    echo "Project ID: {$project->id}\n";
    echo "Name: {$project->name}\n";
    echo "Path: {$project->path}\n";
    echo "Language: {$project->language}\n";
    echo "Framework: {$project->framework}\n";
    echo "Database: " . ($project->database ?? 'none') . "\n";
    echo "Environment: {$project->environment}\n";
    echo "Status: {$project->status}\n";
    echo "Adapter Status: {$project->adapterStatus}\n";
    echo "Hosting: " . ($project->hosting ?? 'not specified') . "\n";
    echo "Created: {$project->createdAt}\n";
    echo "Updated: {$project->updatedAt}\n";

    $exists = $project->pathExists() ? 'yes' : 'no';
    echo "Path Exists: {$exists}\n";
}

function cmdCheck(array $args): void
{
    if (count($args) < 1) {
        fwrite(STDERR, "Error: check requires <id|path>\n");
        exit(1);
    }

    $query = $args[0];
    $registry = Registry::getInstance();

    $project = null;
    if (ctype_digit($query)) {
        $project = $registry->get((int) $query);
    } else {
        $project = $registry->findByPath($query);
    }

    if ($project === null) {
        fwrite(STDERR, "Error: Project not found\n");
        exit(1);
    }

    $detection = Discovery::detect($project->path);

    $issues = [];
    $warnings = [];

    if (!is_readable($project->path)) {
        $issues[] = "Project path not readable";
    }

    if ($project->database && $project->database !== 'none') {
        $envFile = $project->path . '/.env';
        if (!file_exists($envFile) && !file_exists($project->path . '/.env.local')) {
            $warnings[] = "Database configured but no .env file found";
        }
    }

    if (empty($detection['primaryLanguage'])) {
        $warnings[] = "Could not detect primary language";
    }

    echo "Health Check: {$project->name}\n";

    if (empty($issues) && empty($warnings)) {
        echo "  Status: HEALTHY\n";
    } else {
        echo "  Status: ISSUES FOUND\n";
    }

    if (!empty($issues)) {
        echo "  Issues:\n";
        foreach ($issues as $issue) {
            echo "    - {$issue}\n";
        }
    }

    if (!empty($warnings)) {
        echo "  Warnings:\n";
        foreach ($warnings as $warning) {
            echo "    - {$warning}\n";
        }
    }

    Logger::info('Health check completed', ['project' => $project->name, 'healthy' => empty($issues)]);
}

function cmdUnregister(array $args): void
{
    if (count($args) < 1) {
        fwrite(STDERR, "Error: unregister requires <id>\n");
        exit(1);
    }

    $registry = Registry::getInstance();
    $project = $registry->get((int) $args[0]);

    if ($project === null) {
        fwrite(STDERR, "Error: Project not found\n");
        exit(1);
    }

    $registry->remove((int) $args[0]);
    Logger::info('Project unregistered', ['id' => $args[0], 'path' => $project->path]);

    echo "Unregistered project: {$project->name}\n";
}

function cmdFind(array $args): void
{
    if (count($args) < 1) {
        fwrite(STDERR, "Error: find requires <name pattern>\n");
        exit(1);
    }

    $pattern = $args[0];
    $registry = Registry::getInstance();
    $projects = $registry->list();

    $matches = array_filter($projects, fn($p) => stripos($p->name, $pattern) !== false);

    if (empty($matches)) {
        echo "No projects found matching: {$pattern}\n";
        return;
    }

    echo "Matching projects:\n";
    foreach ($matches as $project) {
        echo "  #{$project->id} - {$project->name}\n";
    }
}

function cmdHealth(): void
{
    echo "DevPilot Environment Health\n";
    echo str_repeat("-", 40) . "\n\n";

    $registryPath = Config::getRegistryPath();
    $checks = [
        'Registry' => is_readable($registryPath) || !file_exists($registryPath),
        'Logger Path' => is_writable(ROOT . '/logs'),
    ];

    foreach ($checks as $name => $status) {
        $statusStr = $status ? 'OK' : 'FAIL';
        echo sprintf("  %-20s %s\n", $name . ':', $statusStr);
    }

    echo "\nDevPilot Root: " . ROOT . "\n";
    echo "Registry: " . $registryPath . "\n";
}

function cmdVersion(): void
{
    echo "DevPilot CLI v" . VERSION . "\n";
    echo "PHP " . PHP_VERSION . "\n";
}

$command = $argv[1] ?? 'help';
$args = array_slice($argv, 2);

Logger::info('CLI command executed', ['command' => $command]);

switch ($command) {
    case 'help':
    case '--help':
    case '-h':
        showHelp();
        break;

    case 'version':
    case '-v':
    case '--version':
        cmdVersion();
        break;

    case 'register':
        cmdRegister($args);
        break;

    case 'list':
        cmdList($args);
        break;

    case 'discover':
        cmdDiscover($args);
        break;

    case 'show':
        cmdShow($args);
        break;

    case 'check':
        cmdCheck($args);
        break;

    case 'unregister':
        cmdUnregister($args);
        break;

    case 'find':
        cmdFind($args);
        break;

    case 'health':
        cmdHealth();
        break;

    default:
        fwrite(STDERR, "Error: Unknown command '{$command}'\n");
        showHelp();
        exit(1);
}